{
  "permissions": {
    "allow": [
      "Bash(cd ~/Projects/repos/sportshop-api && python -m pytest --tb=no -q 2>&1 | tail -5)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/elggren/Projects/sportshop-api/.claude/hooks/pre-commit.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/elggren/Projects/sportshop-api/.claude/hooks/security-scan.sh \"$FILE\""
          }
        ]
      }
    ]
  }
}
